<?xml version="1.0" encoding="utf-8"?>
<!--
    Backup and device-transfer rules for Android 12+ (API 31+).

    Keep the AI provider key (in "settings" SharedPreferences) and private history
    off both cloud backup and device-to-device transfer. Saved mini-apps and the
    home dock are still included by default.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="settings.xml" />
        <exclude domain="file" path="conversations.json" />
        <exclude domain="file" path="history.json" />
        <exclude domain="file" path="tabs.json" />
        <exclude domain="file" path="automations.json" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="settings.xml" />
        <exclude domain="file" path="conversations.json" />
        <exclude domain="file" path="history.json" />
        <exclude domain="file" path="tabs.json" />
        <exclude domain="file" path="automations.json" />
    </device-transfer>
</data-extraction-rules>
