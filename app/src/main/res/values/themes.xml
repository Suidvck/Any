<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.Any" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brand</item>
        <item name="colorPrimaryVariant">@color/brand</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorSecondary">@color/clock_color</item>
        <item name="colorSecondaryVariant">@color/clock_color</item>
        <item name="colorOnSecondary">#381E72</item>
        <item name="colorSurface">@color/card_bg</item>
        <item name="colorOnSurface">@color/body_text</item>
        <item name="colorOnSurfaceVariant">@color/muted</item>
        <item name="colorControlActivated">@color/brand</item>
        <item name="colorAccent">@color/brand</item>
        <item name="android:colorBackground">@color/home_bg</item>
        <!-- Edge-to-edge -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">false</item>
        <item name="android:enforceStatusBarContrast" tools:targetApi="29">false</item>
        <item name="android:enforceNavigationBarContrast" tools:targetApi="29">false</item>
        <item name="android:windowBackground">@color/home_bg</item>
        <item name="alertDialogTheme">@style/AnyDialogTheme</item>
        <item name="materialAlertDialogTheme">@style/AnyDialogTheme</item>
        <item name="bottomSheetDialogTheme">@style/AnySheetTheme</item>
    </style>
</resources>
