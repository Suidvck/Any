<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Dark, rounded dialogs that match the app instead of the stock white Material alert. -->
    <style name="AnyDialogTheme" parent="Theme.MaterialComponents.Dialog.Alert">
        <item name="colorPrimary">@color/brand</item>
        <item name="colorPrimaryVariant">@color/brand</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorSecondary">@color/clock_color</item>
        <item name="colorSecondaryVariant">@color/clock_color</item>
        <item name="colorOnSecondary">#381E72</item>
        <item name="colorSurface">@color/card_bg</item>
        <item name="colorOnSurface">@color/body_text</item>
        <item name="colorOnSurfaceVariant">@color/muted</item>
        <item name="android:colorBackground">@color/home_bg</item>
        <item name="android:colorBackgroundFloating">@color/card_bg</item>
        <item name="colorControlActivated">@color/brand</item>
        <item name="colorAccent">@color/brand</item>
        <item name="android:textColorPrimary">@color/body_text</item>
        <item name="android:textColorSecondary">@color/muted</item>
        <item name="android:textColorHint">@color/muted</item>
        <item name="android:windowBackground">@drawable/any_dialog_bg</item>
        <item name="android:backgroundDimAmount">0.42</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">false</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:enforceNavigationBarContrast" tools:targetApi="29">false</item>
        <item name="android:enforceStatusBarContrast" tools:targetApi="29">false</item>
    </style>

    <!-- Bottom sheets: never let Material paint a white surface under our rounded card. -->
    <style name="AnySheetTheme" parent="Theme.MaterialComponents.DayNight.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/AnySheetStyle</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">false</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:enforceNavigationBarContrast" tools:targetApi="29">false</item>
        <item name="android:enforceStatusBarContrast" tools:targetApi="29">false</item>
    </style>

    <style name="AnySheetStyle" parent="Widget.MaterialComponents.BottomSheet.Modal">
        <item name="android:background">@android:color/transparent</item>
        <item name="backgroundTint">@android:color/transparent</item>
    </style>
</resources>
