<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Rounded dialogs use the same palette as the glass surfaces and sheets. -->
    <style name="AnyDialogTheme" parent="Theme.MaterialComponents.Dialog.Alert">
        <item name="colorPrimary">@color/brand</item>
        <item name="colorPrimaryVariant">@color/brand</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/brand</item>
        <item name="colorSecondaryVariant">@color/brand</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorSurface">@color/sheet_bg</item>
        <item name="colorOnSurface">@color/system_text</item>
        <item name="colorOnSurfaceVariant">@color/icon_muted</item>
        <item name="android:colorBackground">@color/sheet_bg</item>
        <item name="android:colorBackgroundFloating">@color/sheet_bg</item>
        <item name="colorControlActivated">@color/brand</item>
        <item name="colorAccent">@color/brand</item>
        <item name="android:textColorPrimary">@color/system_text</item>
        <item name="android:textColorSecondary">@color/icon_muted</item>
        <item name="android:textColorHint">@color/input_hint</item>
        <item name="android:windowBackground">@drawable/any_dialog_bg</item>
        <item name="android:backgroundDimAmount">0.55</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">false</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:enforceNavigationBarContrast" tools:targetApi="29">false</item>
        <item name="android:enforceStatusBarContrast" tools:targetApi="29">false</item>
    </style>

    <!-- Bottom sheets: never let Material paint a white surface under our rounded card. -->
    <style name="AnySheetTheme" parent="Theme.MaterialComponents.DayNight.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/AnySheetStyle</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">false</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:enforceNavigationBarContrast" tools:targetApi="29">false</item>
        <item name="android:enforceStatusBarContrast" tools:targetApi="29">false</item>
    </style>

    <style name="AnySheetStyle" parent="Widget.MaterialComponents.BottomSheet.Modal">
        <item name="android:background">@android:color/transparent</item>
        <item name="backgroundTint">@android:color/transparent</item>
    </style>
</resources>
