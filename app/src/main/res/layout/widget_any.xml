<?xml version="1.0" encoding="utf-8"?>
<!-- RemoteViews-safe layout: only LinearLayout / FrameLayout / TextView /
     TextClock / ImageButton are used. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:paddingLeft="16dp"
    android:paddingTop="12dp"
    android:paddingRight="16dp"
    android:paddingBottom="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:gravity="bottom"
        android:orientation="horizontal">

        <TextClock
            android:id="@+id/widget_clock"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans-serif-black"
            android:format12Hour="HH:mm"
            android:format24Hour="HH:mm"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/widget_accent"
            android:textSize="44sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_marginStart="8dp"
            android:gravity="end"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:letterSpacing="0.18"
                android:text="@string/widget_any_label"
                android:textColor="@color/widget_accent"
                android:textSize="9sp" />

            <TextClock
                android:id="@+id/widget_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:format12Hour="EEEE d MMMM"
                android:format24Hour="EEEE d MMMM"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/widget_muted"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="8dp"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1">

            <ImageButton
                android:id="@+id/widget_chat"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="center"
                android:background="@drawable/widget_btn_bg"
                android:contentDescription="@string/widget_cd_chat"
                android:padding="9dp"
                android:scaleType="fitCenter"
                android:src="@drawable/widget_ic_chat" />
        </FrameLayout>

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1">

            <ImageButton
                android:id="@+id/widget_apps"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="center"
                android:background="@drawable/widget_btn_bg"
                android:contentDescription="@string/widget_cd_apps"
                android:padding="9dp"
                android:scaleType="fitCenter"
                android:src="@drawable/widget_ic_apps" />
        </FrameLayout>

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1">

            <ImageButton
                android:id="@+id/widget_play"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="center"
                android:background="@drawable/widget_btn_bg"
                android:contentDescription="@string/widget_cd_play"
                android:padding="9dp"
                android:scaleType="fitCenter"
                android:src="@drawable/widget_ic_play" />
        </FrameLayout>
    </LinearLayout>
</LinearLayout>
